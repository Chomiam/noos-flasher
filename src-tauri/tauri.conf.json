{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noos-Flasher",
  "version": "0.1.1",
  "identifier": "io.noos.wininstaller",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Noos Flasher — Créateur USB Bootable (Linux & Windows UEFI)",
        "theme": "Dark",
        "width": 1160,
        "height": 840,
        "minWidth": 940,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "linux": {
      "deb": {
        "depends": [
          "parted",
          "dosfstools",
          "ntfs-3g",
          "p7zip-full",
          "policykit-1"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
